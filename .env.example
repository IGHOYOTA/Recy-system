# Copy Supabase Connect > Session pooler connection string here.
# Percent-encode reserved password characters. Never commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
RECY_REQUIRE_POSTGRES=1
# API bearer token; generated automatically by the Render Blueprint.
RECY_API_KEY=replace-with-a-random-secret
